BRING_MAIL=deine@email.de
BRING_PASSWORD=deinPasswort
PORT=3000
# Für die KI-Rezeptanalyse (OpenRouter). Schlüssel anlegen unter https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Optional: Modell überschreiben (Standard: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Passwortschutz (bei öffentlichem Zugriff ZWINGEND setzen). Leer = kein Schutz.
APP_PASSWORD=
# Optional: eigener Schlüssel zum Signieren der Sessions (sonst aus dem Passwort abgeleitet)
APP_SECRET=
# Token für Maschinen-Zugriffe (FHEM, Skripte) auf die /api/-Routen. Leer = aus.
API_TOKEN=
# ── Mealie als Rezeptquelle (optional) ─────────────────────────────────────────
# Ist MEALIE_URL + MEALIE_TOKEN gesetzt, werden Rezepte in Mealie gepflegt und
# hier nur gespiegelt. Wochenplan, Bewertungen, Reste-Suche und Bring bleiben
# in dieser App. Token in Mealie unter "Manage Your API Tokens" erzeugen.
# Getrennt betriebene Instanz: MEALIE_URL=http://192.168.69.10:9925
# Mealie in derselben Stack: COMPOSE_PROFILES=mealie und MEALIE_URL=http://mealie:9000
MEALIE_URL=
MEALIE_TOKEN=
# Mealie mit in dieser Stack starten (leer = aus)
COMPOSE_PROFILES=
# Nur für den mitgelieferten Mealie-Dienst:
MEALIE_PORT=9925
MEALIE_BASE_URL=
MEALIE_VERSION=v3.22.0
MEALIE_DEFAULT_EMAIL=changeme@email.com
# Datenordner für Mealie (leer = benanntes Volume "mealie-data").
# Bei einem Ordner: vorher anlegen und PUID:PGID als Eigentümer setzen.
MEALIE_DATA_PATH=
PUID=1000
PGID=1000
TZ=Europe/Berlin
# Abgleich-Intervall in Minuten (Standard 15)
MEALIE_SYNC_MINUTES=15
# Bewertungen (rating/lastMade) nach Mealie zurückschreiben? 0 = nein
MEALIE_PUSH_RATINGS=1
# Adresse eines Rezepts in der Mealie-Oberfläche; ältere Versionen: {base}/recipe/{slug}
MEALIE_RECIPE_URL={base}/g/home/r/{slug}

# Rezept-Import: Tempo/Timeouts (Standardwerte reichen normalerweise)
IMPORT_DELAY_MS=250
IMPORT_CONCURRENCY=3
IMPORT_TIMEOUT_MS=20000
